# Copy to .env. Everything here is optional — with none of it set, Noggin runs
# on file storage and default ports.

# Postgres. Unset means boards and saved games go to data/ as JSON files.
# Create the tables first:  psql "$DATABASE_URL" -f server/schema.sql
# DATABASE_URL=postgres://noggin:password@127.0.0.1:5432/noggin

# The relay's port. It serves the built site, the API and the WebSocket.
# NOGGIN_PORT=4332

# How long a disconnected player keeps their seat and score, in ms.
# NOGGIN_PLAYER_GRACE_MS=300000

# Upload ceiling for clue media, in bytes.
# NOGGIN_MAX_UPLOAD=26214400
